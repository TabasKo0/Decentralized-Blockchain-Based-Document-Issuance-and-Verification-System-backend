datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ISSUER
  CITIZEN
}

model User {
  id               String             @id @default(uuid())
  address          String             @unique
  role             Role               @default(CITIZEN)
  publicKey        String?
  createdAt        DateTime           @default(now())
  shareRecord      ShareRecord?
  issuedDocuments  DocumentMetadata[] @relation("IssuerRelation")
  citizenDocuments DocumentMetadata[] @relation("CitizenRelation")
}

model ShareRecord {
  id              String   @id @default(uuid())
  userAddress     String   @unique
  user            User     @relation(fields: [userAddress], references: [address], onDelete: Cascade)
  encryptedShareB String
  iv              String
  authTag         String
  createdAt       DateTime @default(now())
}

model DocumentMetadata {
  id                     String              @id @default(uuid())
  documentHash           String              @unique // bytes32 hex anchored on Sepolia
  ipfsCid                String
  docType                String
  issuerAddress          String
  citizenAddress         String
  issuer                 User                @relation("IssuerRelation", fields: [issuerAddress], references: [address])
  citizen                User                @relation("CitizenRelation", fields: [citizenAddress], references: [address])

  // Revocation & Version Provenance
  isRevoked              Boolean             @default(false)
  revokedAt              DateTime?
  revokedTxHash          String?
  revocationReason       String?
  supersededByHash       String?
  expiresAt              DateTime?

  // Forensic Metadata & KMS-wrapped symmetric key for server-side tamper analysis
  kmsEncryptedSessionKey String?
  sessionKeyIv           String?
  sessionKeyAuthTag      String?
  fileSize               Int?
  mimeType               String?
  fileName               String?

  createdAt              DateTime            @default(now())

  // Ephemeral Verification Grants
  grants                 VerificationGrant[]
}

model VerificationGrant {
  id           String           @id @default(uuid())
  token        String           @unique
  documentId   String
  document     DocumentMetadata @relation(fields: [documentId], references: [id], onDelete: Cascade)
  granteeLabel String?
  maxViews     Int              @default(1)
  viewCount    Int              @default(0)
  expiresAt    DateTime
  isRevoked    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([token])
  @@index([documentId])
}
